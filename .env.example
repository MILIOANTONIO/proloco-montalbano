# Database (SQLite file, path relativo alla root del progetto)
DATABASE_URL="file:./prisma/dev.db"

# Sessione admin (stringa lunga e casuale, generarla per produzione)
SESSION_SECRET="cambia-questa-stringa-in-produzione-con-un-valore-lungo-e-casuale"

# Cartella upload per audio/video/immagini dei punti di interesse
UPLOADS_DIR="./uploads"

# Notifiche push (VAPID) — generare con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="mailto:info@example.it"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# URL pubblico del sito (usato per generare i QR code)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
