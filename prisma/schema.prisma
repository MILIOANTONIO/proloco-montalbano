generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model PointOfInterest {
  id           String            @id @default(cuid())
  slug         String            @unique
  category     String // monumento, sala_castello, chiesa, museo, piazza, natura, archeologico
  order        Int               @default(0)
  coverImage   String?
  lat          Float?
  lng          Float?
  published    Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations PoiTranslation[]
  chapters     PoiChapter[]
}

model PoiTranslation {
  id          String          @id @default(cuid())
  locale      String // it | en | es | fr
  title       String
  description String
  audioUrl    String?
  videoUrl    String?
  poi         PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Cascade)
  poiId       String

  @@unique([poiId, locale])
}

// Capitolo interno a un punto di interesse (es. "L'altare maggiore", "Statua di Santa Rita"):
// testo, immagine, audio e video propri, per raccontare i dettagli di un ambiente/opera specifica.
model PoiChapter {
  id           String                  @id @default(cuid())
  order        Int                     @default(0)
  imageUrl     String?
  poi          PointOfInterest         @relation(fields: [poiId], references: [id], onDelete: Cascade)
  poiId        String
  translations PoiChapterTranslation[]
}

model PoiChapterTranslation {
  id        String     @id @default(cuid())
  locale    String
  heading   String
  text      String
  audioUrl  String?
  videoUrl  String?
  chapter   PoiChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String

  @@unique([chapterId, locale])
}

model NewsPost {
  id           String            @id @default(cuid())
  publishedAt  DateTime          @default(now())
  published    Boolean           @default(true)
  coverImage   String?
  coverVideo   String?
  translations NewsTranslation[]
}

model NewsTranslation {
  id     String   @id @default(cuid())
  locale String
  title  String
  body   String
  news   NewsPost @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId String

  @@unique([newsId, locale])
}

model EventItem {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  startDate    DateTime
  endDate      DateTime?
  location     String?
  coverImage   String?
  coverVideoMobile  String?
  coverVideoDesktop String?
  published    Boolean            @default(true)
  translations EventTranslation[]
}

model EventTranslation {
  id          String    @id @default(cuid())
  locale      String
  title       String
  description String
  event       EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String

  @@unique([eventId, locale])
}

model InfoContact {
  id        String   @id @default(cuid())
  category  String // emergenza, farmacia, ufficio, altro
  name      String
  phone     String?
  address   String?
  notes     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String   @id @default("singleton")
  showAward    Boolean  @default(true)
  showAbout    Boolean  @default(true)
  showCards    Boolean  @default(true)
  showAttivita Boolean  @default(true)
  showInstall  Boolean  @default(true)
  sectionOrder String   @default("award,about,cards,attivita,install")
  attivitaBannerImage        String?
  attivitaBannerVideoMobile  String?
  attivitaBannerVideoDesktop String?
  cardPercorsoImage String?
  cardInfoImage     String?
  cardEventiImage   String?
  cardNewsImage     String?
  updatedAt    DateTime @updatedAt
}

// Attività commerciali del borgo (ristoranti, pizzerie, B&B, cantine, botteghe, ecc.)
// promosse in una sezione dedicata della home, per sostenere il commercio locale.
model Activity {
  id           String                 @id @default(cuid())
  categories   String // etichette multiple separate da virgola: ristorazione,panificio,formaggi,macelleria,bnb,affittacamere,cantina,bar,souvenir,altro
  name         String
  address      String?
  phone        String?
  website      String?
  coverImage   String?
  order        Int                    @default(0)
  published    Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations ActivityTranslation[]
}

model ActivityTranslation {
  id          String   @id @default(cuid())
  locale      String
  description String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId  String

  @@unique([activityId, locale])
}

model HeroSlide {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  image        String?
  videoMobile  String?
  videoDesktop String?
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("it")
  createdAt DateTime @default(now())
}

// Visite alle pagine pubbliche, per le statistiche nella dashboard admin.
model PageView {
  id        String   @id @default(cuid())
  path      String
  locale    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
